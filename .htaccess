Options -MultiViews

RewriteEngine On

# Redirect direct .html requests to extensionless URLs
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Serve matching .html files when the extension is omitted
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)$ $1.html [L]
